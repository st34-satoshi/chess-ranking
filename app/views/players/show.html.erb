
<% content_for :title do %>
  <title><%= t('views.players.title') %> - <%= @player.name_of(@locale) %></title>
<% end %>
<% content_for :description do %>
  <meta name="description" content="<%= t('views.players.show.description', name: @player.name_of(@locale)) %>">
<% end %>
<% content_for :ogp do %>
  <meta property="og:title" content="<%= t('views.players.title') %> - <%= @player.name_of(@locale) %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= player_url(@player.public_uid) %>">
  <meta property="og:description" content="<%= t('views.players.show.description', name: @player.name_of(@locale)) %>">
  <meta property="og:image" content="https://chess-ranking.stu345.com/ogp.jpg">
<% end %>
<% content_for :canonical do %>
  <link rel="canonical" href="<%= player_url(@player.public_uid, locale: @locale) %>">
<% end %>

<% content_for :importmap_tag do %>
  <%= javascript_importmap_tags 'player/show' %>
<% end %>

<div class="container" style="min-height: 100%;">
    <div class='row mx-auto pl-1 pr-1 min-vh-100'>
    <div class="d-flex flex-column mx-auto mw-100">
    <div>

    <%= render "layouts/header" %>

    <h1 class="pt-3"><%= @player.name_en + ' ( ' + @player.name_jp + ' )' %></h1>
    <hr>

    <h5><%= t('views.players.show.federation_id') %>: <%= @player.ncs_id %></h5>
    <div class="row pt-2">
      <div class="col-md-6 mb-3">
        <h2 class="h5"><%= t('views.players.show.standard') %></h2>
        <p class="mb-0"><%= t('views.players.show.current') %>: <%= @player.current_rating %> / <%= t('views.players.show.best') %>: <%= @player.best_rating %></p>
      </div>
      <div class="col-md-6 mb-3">
        <h2 class="h5"><%= t('views.players.show.rapid') %></h2>
        <p class="mb-0"><%= t('views.players.show.current') %>: <%= @player.current_rapid_rating || t('views.players.show.unrated') %> / <%= t('views.players.show.best') %>: <%= @player.best_rapid_rating || t('views.players.show.unrated') %></p>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6 mb-3">
        <h2 class="h5"><%= t('views.players.show.standard_rank') %></h2>
        <p class="mb-0"><%= t('views.players.show.current') %>: <%= @player.current_rank || '—' %> / <%= t('views.players.show.best') %>: <%= @player.best_rank || '—' %></p>
      </div>
      <div class="col-md-6 mb-3">
        <h2 class="h5"><%= t('views.players.show.rapid_rank') %></h2>
        <p class="mb-0"><%= t('views.players.show.current') %>: <%= @player.current_rapid_rank || '—' %> / <%= t('views.players.show.best') %>: <%= @player.best_rapid_rank || '—' %></p>
      </div>
    </div>

    <div class="pt-3">
      <h2 class="h5"><%= t('views.players.show.rating_history') %></h2>
      <p id="ratingNoData" class="d-none" role="status"><%= t('views.players.show.no_rating_data') %></p>
      <canvas id="ratingChart" data-record='<%= @player.rating_record_objects %>' data-date='<%= @player.dates %>'
              data-standard-label="<%= t('views.players.show.standard') %>" data-rapid-label="<%= t('views.players.show.rapid') %>"></canvas>
    </div>

    <div class="pt-3">
      <h2 class="h5"><%= t('views.players.show.rank_history') %></h2>
      <p id="rankNoData" class="d-none" role="status"><%= t('views.players.show.no_rank_data') %></p>
      <canvas id="rankChart" data-record='<%= @player.rank_record_objects %>' data-date='<%= @player.dates %>'
              data-standard-label="<%= t('views.players.show.standard') %>" data-rapid-label="<%= t('views.players.show.rapid') %>"></canvas>
    </div>

    <div class="pt-3 text-center pb-3">
      Share:
      <%= link_to "https://twitter.com/intent/tweet?text=#{@player.name_jp} - #{t('views.players.title')}&url=#{request.url}", {target: "_blank", class: "btn btn-outline-primary"} do %>
        <i class="fa-brands fa-x-twitter fa-sm"></i>
      <% end %>
    </div>

    </div>
    </div>
    </div>
</div>